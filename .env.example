# --- Wallet / x402 settings ---
# Your receive address (USDC on Base). Get one: https://portal.cdp.coinbase.com
X402_PAY_TO_ADDRESS=0xYourReceiveAddressHere
X402_CHAIN=base
X402_ASSET=USDC
X402_NETWORK_VERSION=1

# Coinbase CDP facilitator (zero fee on Base). Leave blank to use public facilitator.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402/facilitator

# --- Stripe fallback for fiat ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# --- License keys (for gateway-as-a-product tier) ---
LICENSE_SECRET=change-me-long-random-string
LICENSE_ISSUER=claudeoperators.com

# --- Upstream MCP to wrap ---
# Either set UPSTREAM_COMMAND for stdio MCPs (wrapped), or UPSTREAM_URL for HTTP MCPs.
UPSTREAM_COMMAND=
UPSTREAM_ARGS=
UPSTREAM_URL=

# --- Gateway ---
PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info

# --- Pricing config path (JSON) ---
PRICING_CONFIG=./pricing.json
